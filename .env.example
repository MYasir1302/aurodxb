# Google Gemini API Key (Required for live AI generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis REST Credentials (Required for production rate limiting and persistence)
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Resend API Key & Destination (Optional - for sending emails from /contact)
# Sign up at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=your_email@domain.com
